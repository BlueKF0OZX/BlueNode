# Copy to /etc/bluenode/remote-access.conf, edit, then chmod 0600 and chown root:root.
# This example contains no deployable hostname, credential, token, or certificate.
BLUENODE_REMOTE_MODE=direct
BLUENODE_REMOTE_HOST=dashboard.example.invalid
BLUENODE_BACKEND_URL=http://127.0.0.1:8080
BLUENODE_CERTIFICATE_FILE=/path/to/fullchain.pem
BLUENODE_CERTIFICATE_KEY_FILE=/path/to/privkey.pem
BLUENODE_AUTH_USER_FILE=/etc/bluenode/remote-users.htpasswd

# Tunnel mode is configured by an operator with a chosen provider. The tunnel
# must enforce authentication for all routes and use the loopback backend.
# BLUENODE_REMOTE_MODE=tunnel
# BLUENODE_TUNNEL_AUTHENTICATION_ACK=required
