[Unit]

Description=NodeSmart AllStar Monitor

Wants=network-online.target
After=network-online.target asterisk.service


[Service]

Type=simple

User=NODESMART_USER
Group=NODESMART_GROUP
UMask=0027
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

WorkingDirectory=/opt/nodesmart/core

ExecStart=/usr/bin/python3 /opt/nodesmart/core/monitor.py

Restart=always

RestartSec=5


[Install]

WantedBy=multi-user.target
